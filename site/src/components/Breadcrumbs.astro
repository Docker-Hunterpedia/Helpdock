---
import { CHROME, type Locale } from '../data/site.ts';
import type { Crumb } from '../lib/seo.ts';

type Props = { crumbs: Crumb[]; locale?: Locale };
const { crumbs, locale = 'en' } = Astro.props;
---
<nav class="crumbs" aria-label={CHROME[locale].breadcrumb} data-pagefind-ignore>
  <ol>
    {
      crumbs.map((crumb, index) =>
        index === crumbs.length - 1 ? (
          <li>
            <span aria-current="page">{crumb.name}</span>
          </li>
        ) : (
          <li>
            <a href={crumb.href}>{crumb.name}</a>
          </li>
        ),
      )
    }
  </ol>
</nav>
