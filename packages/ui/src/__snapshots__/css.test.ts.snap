// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`tokensCssBundle > matches the published stylesheet 1`] = `
":root {
  --hd-bg-canvas: #F7F5F0;
  --hd-bg-surface: #FFFFFF;
  --hd-bg-muted: #EFECE5;
  --hd-bg-inverse: #16181C;
  --hd-text-primary: #16181C;
  --hd-text-secondary: #5C564C;
  --hd-text-disabled: #A8A196;
  --hd-text-inverse: #FFFFFF;
  --hd-text-link: #0F766E;
  --hd-border-default: #E3DFD6;
  --hd-border-strong: #CFC9BD;
  --hd-border-focus: #0F766E;
  --hd-action-primary: #0F766E;
  --hd-action-primary-hover: #0C5F59;
  --hd-action-primary-active: #0A4A45;
  --hd-action-primary-text: #FFFFFF;
  --hd-action-primary-tint: #ECF7F5;
  --hd-status-success: #2E7D4F;
  --hd-status-success-tint: #E7F3EC;
  --hd-status-success-text: #1F5A38;
  --hd-status-warning: #B45309;
  --hd-status-warning-tint: #FBEEDF;
  --hd-status-warning-text: #7C3A06;
  --hd-status-danger: #B3261E;
  --hd-status-danger-tint: #FBE7E5;
  --hd-status-danger-text: #8A1B15;
  --hd-status-info: #2B5FB3;
  --hd-status-info-tint: #E6EEF9;
  --hd-status-info-text: #1E4483;
  --hd-status-escalated: #6B4FBB;
  --hd-status-escalated-tint: #EEEAF8;
  --hd-status-escalated-text: #46307F;
  --hd-elevation-0: none;
  --hd-elevation-1: 0 1px 2px rgba(22, 24, 28, 0.06);
  --hd-elevation-2: 0 4px 12px rgba(22, 24, 28, 0.10);
  --hd-elevation-3: 0 12px 32px rgba(22, 24, 28, 0.16);
  --hd-radius-sm: 4px;
  --hd-radius-md: 6px;
  --hd-radius-lg: 10px;
  --hd-radius-xl: 14px;
  --hd-radius-full: 999px;
  --hd-space-2: 2px;
  --hd-space-4: 4px;
  --hd-space-8: 8px;
  --hd-space-12: 12px;
  --hd-space-16: 16px;
  --hd-space-20: 20px;
  --hd-space-24: 24px;
  --hd-space-32: 32px;
  --hd-space-40: 40px;
  --hd-space-48: 48px;
  --hd-space-64: 64px;
  --hd-font-sans: 'IBM Plex Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
  --hd-font-arabic: 'IBM Plex Sans Arabic', 'IBM Plex Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
  --hd-font-mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  --hd-weight-regular: 400;
  --hd-weight-medium: 500;
  --hd-weight-semibold: 600;
  --hd-type-display-size: 32px;
  --hd-type-display-line: 40px;
  --hd-type-display-weight: 600;
  --hd-type-h1-size: 24px;
  --hd-type-h1-line: 32px;
  --hd-type-h1-weight: 600;
  --hd-type-h2-size: 20px;
  --hd-type-h2-line: 28px;
  --hd-type-h2-weight: 600;
  --hd-type-h3-size: 16px;
  --hd-type-h3-line: 24px;
  --hd-type-h3-weight: 600;
  --hd-type-body-lg-size: 16px;
  --hd-type-body-lg-line: 24px;
  --hd-type-body-lg-weight: 400;
  --hd-type-body-size: 14px;
  --hd-type-body-line: 20px;
  --hd-type-body-weight: 400;
  --hd-type-body-strong-size: 14px;
  --hd-type-body-strong-line: 20px;
  --hd-type-body-strong-weight: 500;
  --hd-type-caption-size: 12px;
  --hd-type-caption-line: 16px;
  --hd-type-caption-weight: 500;
  --hd-type-mono-size: 13px;
  --hd-type-mono-line: 20px;
  --hd-type-mono-weight: 400;
  --hd-duration-fast: 120ms;
  --hd-duration-base: 200ms;
  --hd-duration-slow: 320ms;
  --hd-ease-out: ease-out;
  --hd-ease-emphasized: cubic-bezier(0.2, 0, 0, 1);
  --hd-focus-width: 2px;
  --hd-focus-offset: 2px;
  --hd-focus-style: solid;
}

@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --hd-bg-canvas: #15171B;
    --hd-bg-surface: #1C1F24;
    --hd-bg-muted: #23272E;
    --hd-bg-inverse: #EFECE5;
    --hd-text-primary: #ECEBE6;
    --hd-text-secondary: #A8A196;
    --hd-text-disabled: #7D7669;
    --hd-text-inverse: #16181C;
    --hd-text-link: #5FB8AC;
    --hd-border-default: #2E333B;
    --hd-border-strong: #3A404A;
    --hd-border-focus: #5FB8AC;
    --hd-action-primary: #5FB8AC;
    --hd-action-primary-hover: #9DD6CD;
    --hd-action-primary-active: #CDEBE6;
    --hd-action-primary-text: #16181C;
    --hd-action-primary-tint: #123331;
    --hd-status-success: #6EBB89;
    --hd-status-success-tint: #263230;
    --hd-status-success-text: #6EBB89;
    --hd-status-warning: #F89156;
    --hd-status-warning-tint: #362D2A;
    --hd-status-warning-text: #F89156;
    --hd-status-danger: #FA6B5B;
    --hd-status-danger-tint: #37282B;
    --hd-status-danger-text: #FA6B5B;
    --hd-status-info: #659DF6;
    --hd-status-info-tint: #252E3D;
    --hd-status-info-text: #659DF6;
    --hd-status-escalated: #A58DFF;
    --hd-status-escalated-tint: #2C2C3E;
    --hd-status-escalated-text: #A58DFF;
    --hd-elevation-0: none;
    --hd-elevation-1: none;
    --hd-elevation-2: none;
    --hd-elevation-3: none;
  }
}

:root[data-theme="dark"] {
  --hd-bg-canvas: #15171B;
  --hd-bg-surface: #1C1F24;
  --hd-bg-muted: #23272E;
  --hd-bg-inverse: #EFECE5;
  --hd-text-primary: #ECEBE6;
  --hd-text-secondary: #A8A196;
  --hd-text-disabled: #7D7669;
  --hd-text-inverse: #16181C;
  --hd-text-link: #5FB8AC;
  --hd-border-default: #2E333B;
  --hd-border-strong: #3A404A;
  --hd-border-focus: #5FB8AC;
  --hd-action-primary: #5FB8AC;
  --hd-action-primary-hover: #9DD6CD;
  --hd-action-primary-active: #CDEBE6;
  --hd-action-primary-text: #16181C;
  --hd-action-primary-tint: #123331;
  --hd-status-success: #6EBB89;
  --hd-status-success-tint: #263230;
  --hd-status-success-text: #6EBB89;
  --hd-status-warning: #F89156;
  --hd-status-warning-tint: #362D2A;
  --hd-status-warning-text: #F89156;
  --hd-status-danger: #FA6B5B;
  --hd-status-danger-tint: #37282B;
  --hd-status-danger-text: #FA6B5B;
  --hd-status-info: #659DF6;
  --hd-status-info-tint: #252E3D;
  --hd-status-info-text: #659DF6;
  --hd-status-escalated: #A58DFF;
  --hd-status-escalated-tint: #2C2C3E;
  --hd-status-escalated-text: #A58DFF;
  --hd-elevation-0: none;
  --hd-elevation-1: none;
  --hd-elevation-2: none;
  --hd-elevation-3: none;
}
"
`;
