{
  "name": "@helpdock/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NestJS REST API, WebSocket gateway, SSR host and worker.",
  "license": "AGPL-3.0-only",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch --env-file-if-exists=../../.env dist/main.js",
    "dev:build": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "vitest run --config ../../vitest.config.ts --project @helpdock/api"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.1",
    "@fastify/static": "10.1.4",
    "@helpdock/config": "workspace:*",
    "@helpdock/db": "workspace:*",
    "@helpdock/jobs": "workspace:*",
    "@helpdock/schemas": "workspace:*",
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-fastify": "12.0.3",
    "bullmq": "6.3.6",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.4",
    "ioredis": "6.0.0",
    "nestjs-zod": "5.5.0",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.0.3",
    "@testcontainers/postgresql": "12.1.0",
    "@testcontainers/redis": "12.1.0"
  }
}
