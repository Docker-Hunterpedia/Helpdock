{
  "name": "@helpdock/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Typed, Zod-validated configuration loader.",
  "license": "AGPL-3.0-only",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "vitest run --config ../../vitest.config.ts --project @helpdock/config"
  },
  "dependencies": {
    "ioredis": "6.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testcontainers/redis": "12.1.0"
  }
}
