{
  "name": "helpdock",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Open-source, self-hosted customer support platform.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Docker-Hunterpedia/Helpdock.git"
  },
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run --coverage --project=!integration",
    "test:integration": "vitest run --project=integration",
    "test:watch": "vitest",
    "check:boundaries": "node scripts/check-app-boundaries.ts",
    "check:routes": "node scripts/check-route-permissions.ts",
    "check:validation": "node scripts/check-route-validation.ts",
    "changeset": "changeset",
    "changeset:version": "changeset version"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@types/node": "24.13.5",
    "@vitest/coverage-v8": "5.0.1",
    "turbo": "2.10.13",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
