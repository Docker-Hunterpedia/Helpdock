---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found · Helpdock" description="This page does not exist. Go to the Helpdock home page, the channels, the features or the documentation." noindex>
  <section class="container not-found">
    <p class="eyebrow">404</p>
    <h1 class="display page-title">This page does not exist.</h1>
    <p class="lead" lang="ar" dir="rtl">هذه الصفحة غير موجودة.</p>
    <div class="actions">
      <a class="btn btn-primary" href="/">Go to the home page</a>
      <a class="btn btn-secondary" href="/ar/" lang="ar">الصفحة الرئيسية</a>
      <a class="more" href="/docs/">Read the docs</a>
    </div>
  </section>
</Base>
