{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommitTypeAll(chore)"],
  "timezone": "Etc/UTC",
  "schedule": ["* 0-6 * * 1"],
  "labels": ["dependencies"],
  "rangeStrategy": "pin",
  "prConcurrentLimit": 5,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-6 * * 1"]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["dependencies", "security"],
    "schedule": ["at any time"],
    "prPriority": 10
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Group GitHub Actions bumps into one pull request.",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "Group non-breaking toolchain bumps into one pull request.",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "dev dependencies"
    },
    {
      "description": "Node stays on the 24 LTS line until the stack table changes.",
      "matchPackageNames": ["node", "@types/node"],
      "allowedVersions": "<25"
    }
  ]
}
