{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "scripts/**/*.ts",
    "packages/*/scripts/**/*.ts",
    "apps/*/src/**/*.test.ts",
    "packages/*/src/**/*.test.ts"
  ]
}
