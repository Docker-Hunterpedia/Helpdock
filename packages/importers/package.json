{
  "name": "@helpdock/importers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Resumable support-platform import connectors and streaming file readers.",
  "license": "AGPL-3.0-only",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "vitest run --config ../../vitest.config.ts --project @helpdock/importers"
  },
  "dependencies": {
    "@helpdock/net": "workspace:*",
    "@helpdock/schemas": "workspace:*",
    "csv-parse": "7.0.3",
    "yauzl": "3.4.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/yauzl": "3.4.0"
  }
}
