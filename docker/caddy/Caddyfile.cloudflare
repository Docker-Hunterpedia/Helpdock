# The same routing as ./Caddyfile, for an install whose hostnames are proxied by
# Cloudflare (orange cloud). Select it with `CADDYFILE=./caddy/Caddyfile.cloudflare`
# in `.env`; docs/guides/install.md has the rest.
#
# Three differences, all because Cloudflare sits in front of Caddy:
#
# 1. There is no on-demand TLS and no catch-all site. Cloudflare presents its own
#    certificate, so Caddy never needs one for a brand domain — and leaving
#    on-demand on would make every hostname anyone points at this origin cost an
#    issuance attempt.
# 2. Brand help-center domains are added in the commented block at the end by
#    hand, or a wildcard that covers them is, because nothing issues them
#    automatically any more. M5's custom-domain screen says so too.
# 3. The visitor's address. Caddy's peer is a Cloudflare edge address, and Caddy
#    forwards its peer's address as `X-Forwarded-For` unless that peer is
#    trusted. Without `trusted_proxies` the api would see an edge address for
#    every visitor and key every per-address limit (sign-in, widget, web form,
#    rating page) on it, so one visitor could lock the rest out. With it, Caddy
#    believes Cloudflare's `CF-Connecting-IP` header when, and only when, the
#    peer is in these ranges, and `helpdock_upstream` forwards that one address
#    as `X-Forwarded-For`. A request that reaches this server around Cloudflare
#    is not from these ranges, so a `CF-Connecting-IP` it carries is ignored and
#    its own address is used.
#
# The ranges are Cloudflare's published list (https://www.cloudflare.com/ips/),
# as of 2026-10-09. Cloudflare changes it rarely and announces it: compare it
# with the list now and then, and `docker compose restart caddy` after editing.
# A range that is missing here fails safe. Visitors arriving through that edge
# are seen as the edge, as they were before, and nothing becomes spoofable.
#
# Cloudflare must be in "Full (strict)" mode with an origin certificate, or the
# connection between Cloudflare and this server is not authenticated.
{
	email "{$ACME_EMAIL}"

	servers {
		trusted_proxies static \
 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 \
 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 \
 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 \
 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 \
 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 \
 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

(helpdock_upstream) {
	handle /internal/* {
		respond "Not found" 404
	}

	handle {
		reverse_proxy api:3000 {
			header_up X-Request-Id {http.request.uuid}
			header_up X-Forwarded-Host {host}
			# One address, the visitor's: `CF-Connecting-IP` from a Cloudflare
			# peer, the peer itself from anyone else. The api believes this one
			# hop, Caddy, and takes the address as `request.ip`.
			header_up X-Forwarded-For {client_ip}
		}
	}
}

{$ADMIN_HOST}, {$API_HOST} {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	import helpdock_upstream
}

# Add each verified brand help-center domain here, then `docker compose restart
# caddy`. Cloudflare terminates TLS in front of it, so no certificate is issued.
# help.brand-a.example, help.brand-b.example {
# 	import helpdock_upstream
# }
