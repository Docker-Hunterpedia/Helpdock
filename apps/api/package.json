{
  "name": "@helpdock/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NestJS REST API, WebSocket gateway, SSR host and worker.",
  "license": "AGPL-3.0-only",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --import ./dist/observability/instrumentation.js --watch --env-file-if-exists=../../.env dist/main.js",
    "dev:build": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "start": "node --import ./dist/observability/instrumentation.js dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "vitest run --config ../../vitest.config.ts --project @helpdock/api",
    "seed:dev": "node dist/seed/seed-dev.js",
    "test:coverage": "vitest run --config vitest.coverage.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/static": "10.1.4",
    "@helpdock/channels": "workspace:*",
    "@helpdock/config": "workspace:*",
    "@helpdock/db": "workspace:*",
    "@helpdock/i18n": "workspace:*",
    "@helpdock/jobs": "workspace:*",
    "@helpdock/schemas": "workspace:*",
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-fastify": "12.0.3",
    "@nestjs/platform-socket.io": "12.0.3",
    "@nestjs/websockets": "12.0.3",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/instrumentation-fastify": "0.57.0",
    "@opentelemetry/instrumentation-http": "0.222.0",
    "@opentelemetry/instrumentation-ioredis": "0.70.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@socket.io/redis-adapter": "8.3.0",
    "argon2": "0.45.1",
    "bullmq": "6.3.6",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.4",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "nestjs-zod": "5.5.0",
    "otplib": "13.5.0",
    "pino": "10.3.1",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.0.3",
    "@testcontainers/postgresql": "12.1.0",
    "@testcontainers/redis": "12.1.0",
    "pino-pretty": "13.1.3",
    "socket.io-client": "4.8.3",
    "testcontainers": "12.1.0"
  }
}
