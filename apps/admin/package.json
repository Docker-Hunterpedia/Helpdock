{
  "name": "@helpdock/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Vite + React admin SPA for agents and administrators.",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "vitest run --config ../../vitest.config.ts --project @helpdock/admin",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "e2e": "playwright test --grep-invert @screenshot",
    "e2e:baselines": "node scripts/update-screenshots.ts --grep @screenshot",
    "e2e:screenshots": "playwright test --grep @screenshot"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@helpdock/i18n": "workspace:*",
    "@helpdock/ui": "workspace:*",
    "@mui/material": "9.4.0",
    "@tanstack/react-query": "5.103.1",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.14",
    "react-router": "8.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "happy-dom": "20.14.5",
    "vite": "8.3.0"
  }
}
