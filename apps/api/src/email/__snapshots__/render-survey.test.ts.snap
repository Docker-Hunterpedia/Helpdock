exports[`renderDelivery, a satisfaction survey > matches the Arabic artboard, laid out right to left > html 1`] = `"<!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"></head><body style="margin:0;padding:24px 0;background:#EFECE5;font-family:'IBM Plex Sans Arabic','IBM Plex Sans',ui-sans-serif,system-ui,sans-serif;color:#16181C"><table role="presentation" dir="rtl" width="600" cellpadding="0" cellspacing="0" style="width:600px;max-width:100%;margin:0 auto;background:#FFFFFF;border:1px solid #E3DFD6;border-radius:10px;border-collapse:separate"><tr><td style="padding:20px 32px;border-bottom:1px solid #EFECE5"><span style="display:inline-block;width:32px;height:32px;line-height:32px;border-radius:6px;background:#0F766E;color:#FFFFFF;font-weight:600;text-align:center;vertical-align:middle">H</span>&nbsp;&nbsp;<span style="font-weight:600;font-size:16px;vertical-align:middle">Helpdock</span></td></tr><tr><td style="padding:24px 32px;font-size:16px;line-height:24px"><p style="margin:0 0 16px 0">مرحباً سارة،</p><p style="margin:0 0 16px 0">أُغلق طلبك <bdi style="font-family:'IBM Plex Mono',ui-monospace,monospace">HD-1042</bdi> اليوم على يد لينا، ونودّ أن نعرف رأيك.</p><h1 style="margin:0 0 16px 0;font-size:20px;line-height:28px;font-weight:600">ما تقييمك للمساعدة التي تلقيتها؟</h1><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;margin:0 0 16px 0;border-collapse:collapse"><tr><td width="20%" style="padding:0 2px"><a href="https://desk.helpdock.io/csat/tok?rating=1&amp;lang=ar" aria-label="التقييم 1 من 5، سيئ جداً" style="display:block;padding:10px 4px;border:1px solid #CFC9BD;border-radius:6px;text-align:center;text-decoration:none;color:#16181C"><span style="display:block;font-family:'IBM Plex Mono',ui-monospace,monospace;font-size:20px;line-height:28px;font-weight:500">1</span><span style="display:block;font-size:12px;line-height:16px;color:#5C564C">سيئ جداً</span></a></td><td width="20%" style="padding:0 2px"><a href="https://desk.helpdock.io/csat/tok?rating=2&amp;lang=ar" aria-label="التقييم 2 من 5، سيئ" style="display:block;padding:10px 4px;border:1px solid #CFC9BD;border-radius:6px;text-align:center;text-decoration:none;color:#16181C"><span style="display:block;font-family:'IBM Plex Mono',ui-monospace,monospace;font-size:20px;line-height:28px;font-weight:500">2</span><span style="display:block;font-size:12px;line-height:16px;color:#5C564C">سيئ</span></a></td><td width="20%" style="padding:0 2px"><a href="https://desk.helpdock.io/csat/tok?rating=3&amp;lang=ar" aria-label="التقييم 3 من 5، مقبول" style="display:block;padding:10px 4px;border:1px solid #CFC9BD;border-radius:6px;text-align:center;text-decoration:none;color:#16181C"><span style="display:block;font-family:'IBM Plex Mono',ui-monospace,monospace;font-size:20px;line-height:28px;font-weight:500">3</span><span style="display:block;font-size:12px;line-height:16px;color:#5C564C">مقبول</span></a></td><td width="20%" style="padding:0 2px"><a href="https://desk.helpdock.io/csat/tok?rating=4&amp;lang=ar" aria-label="التقييم 4 من 5، جيد" style="display:block;padding:10px 4px;border:1px solid #CFC9BD;border-radius:6px;text-align:center;text-decoration:none;color:#16181C"><span style="display:block;font-family:'IBM Plex Mono',ui-monospace,monospace;font-size:20px;line-height:28px;font-weight:500">4</span><span style="display:block;font-size:12px;line-height:16px;color:#5C564C">جيد</span></a></td><td width="20%" style="padding:0 2px"><a href="https://desk.helpdock.io/csat/tok?rating=5&amp;lang=ar" aria-label="التقييم 5 من 5، ممتاز" style="display:block;padding:10px 4px;border:1px solid #CFC9BD;border-radius:6px;text-align:center;text-decoration:none;color:#16181C"><span style="display:block;font-family:'IBM Plex Mono',ui-monospace,monospace;font-size:20px;line-height:28px;font-weight:500">5</span><span style="display:block;font-size:12px;line-height:16px;color:#5C564C">ممتاز</span></a></td></tr></table><p style="margin:0 0 16px 0;font-size:14px;line-height:20px">اختر رقماً لتفتح صفحة الاستبيان وهو محدد مسبقاً. يمكنك إضافة تعليق هناك قبل الإرسال.</p><p style="margin:0;font-size:12px;line-height:16px;color:#5C564C">يعمل هذا الرابط مرة واحدة وينتهي بعد 30 يوماً. هذه رسالة تلقائية؛ الرد عليها يضيف إلى طلبك.</p></td></tr><tr><td style="padding:0 32px"><div style="padding:12px 16px;border-radius:6px;background:#F7F5F0;font-size:13px;line-height:20px;color:#403C35"><span style="font-weight:500">رقم الطلب</span> <bdi style="font-family:'IBM Plex Mono',ui-monospace,monospace">[HD-1042]</bdi> · استفسار عن رسوم الشحن الدولي<br><span style="color:#5C564C">للرد، أجب على هذه الرسالة وسيُضاف ردّك إلى طلبك. أبقِ رقم الطلب في الموضوع.</span></div></td></tr><tr><td style="padding:20px 32px 24px 32px;font-size:12px;line-height:16px;color:#5C564C">Helpdock<br>تصلك هذه الرسالة لأنك تواصلت مع دعم Helpdock.</td></tr></table></body></html>"`;

exports[`renderDelivery, a satisfaction survey > matches the Arabic artboard, laid out right to left > text 1`] = `
"مرحباً سارة،

أُغلق طلبك HD-1042 اليوم على يد لينا، ونودّ أن نعرف رأيك.

ما تقييمك للمساعدة التي تلقيتها؟

1 · سيئ جداً  https://desk.helpdock.io/csat/tok?rating=1&lang=ar
2 · سيئ       https://desk.helpdock.io/csat/tok?rating=2&lang=ar
3 · مقبول     https://desk.helpdock.io/csat/tok?rating=3&lang=ar
4 · جيد       https://desk.helpdock.io/csat/tok?rating=4&lang=ar
5 · ممتاز     https://desk.helpdock.io/csat/tok?rating=5&lang=ar

يعمل هذا الرابط مرة واحدة وينتهي بعد 30 يوماً. هذه رسالة تلقائية؛ الرد عليها يضيف إلى طلبك.

رقم الطلب [HD-1042] · استفسار عن رسوم الشحن الدولي
للرد، أجب على هذه الرسالة وسيُضاف ردّك إلى طلبك. أبقِ رقم الطلب في الموضوع.

Helpdock
تصلك هذه الرسالة لأنك تواصلت مع دعم Helpdock."
`;

