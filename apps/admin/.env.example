# Build-time configuration for the admin SPA. Copy to `.env.local` to override.
# Only `VITE_`-prefixed keys reach the browser bundle; everything the server
# needs is in the repository root `.env.example` instead.

# Which auth adapter the bundle is built with (apps/admin/src/auth/select-api.ts).
#   mock  the in-memory fixture in `src/auth/mock-api.ts`
#   http  the real service, which arrives with M0-05
# Unset means `mock` in dev and test and `http` in a production build.
VITE_AUTH_API=mock
